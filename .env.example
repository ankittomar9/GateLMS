# Database Credentials (Overrides for docker-compose and application.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=gatelms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Configuration
SERVER_PORT=8080
FRONTEND_PORT=5173

# Observability Configuration (Grafana Admin Authentication - required when running --profile observability)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change_me_in_production
