# Database Credentials (Overrides for docker-compose and application.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=gatelms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Configuration
SERVER_PORT=8080
FRONTEND_PORT=5173

# Initial Bootstrap Admin Password (Required for initial login of operator 'ankur')
GATELMS_ADMIN_INITIAL_PASSWORD=change_me_to_a_secure_admin_password

# Observability Configuration (Grafana Admin Authentication - required when running --profile observability)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change_me_in_production

# AI Studio & Whisper Sidecar Configuration (Optional - defaults to zero-egress local Ollama / Whisper)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_ENDPOINT=http://localhost:11434
# WHISPER_ENDPOINT=http://localhost:8178/inference
# STT_PROVIDER=auto
